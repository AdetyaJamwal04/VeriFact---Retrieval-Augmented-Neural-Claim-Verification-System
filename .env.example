# Copy this file to .env and populate the values you need.
# Example: cp .env.example .env

# Tavily API Key (primary search provider; recommended for best results)
# Get your free key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API Key (secondary fallback provider)
# Get your free key from: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Groq API Key (optional; enables LLM decomposition, tiebreaking, and summaries)
# Get your free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face token (optional; only needed for some gated model access)
HF_API_TOKEN=your_huggingface_token_here

# Flask server configuration
PORT=5000
DEBUG=false
